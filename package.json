{
  "name": "multimodal-math-engine",
  "private": true,
  "version": "0.1.0",
  "description": "MathCanvas — AI-native interactive 2D/3D geometry, university higher-math (calculus, ODE/PDE, linear algebra, probability), conics & CAD workbench (Windows, Android & Web)",
  "homepage": "https://huo0077.github.io/mathcanvas/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Huo0077/mathcanvas.git"
  },
  "bugs": {
    "url": "https://github.com/Huo0077/mathcanvas/issues",
    "email": "dogf9066@gmail.com"
  },
  "keywords": [
    "mathcanvas",
    "geogebra-alternative",
    "mathematics",
    "math-visualization",
    "geometry",
    "3d-geometry",
    "solid-geometry",
    "dynamic-geometry",
    "conics",
    "calculus",
    "multivariable-calculus",
    "lagrange-multipliers",
    "differential-equations",
    "ode-solver",
    "pde-simulation",
    "phase-plane",
    "taylor-series",
    "fourier-series",
    "double-integral",
    "linear-algebra",
    "svd",
    "probability-statistics",
    "cad",
    "ai-agent",
    "deepseek",
    "educational-software",
    "edtech",
    "tauri",
    "threejs",
    "android"
  ],
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @draw/web run dev",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces && tsc -p e2e/tsconfig.json && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:docs": "vitest run scripts/docs-consistency",
    "test:perf": "vitest run --silent=false packages/scene-graph/src/largeScene.bench.test.ts",
    "test:lean": "vitest run --config vitest.lean.config.ts --maxWorkers=1",
    "test:e2e": "playwright test",
    "eval:agent": "node scripts/agent-eval.mjs",
    "eval:solid": "node scripts/solid-eval/runner.mjs",
    "eval:reliability": "node scripts/reliability-eval/runner.mjs",
    "eval:explicit-solid": "node scripts/explicit-solid-acceptance/runner.mjs",
    "bench:agent": "node scripts/agent-benchmark/runner.mjs",
    "proof:smoke": "node scripts/proof-spike/runner.mjs",
    "licences:scan": "node scripts/dependency-licences/scan.mjs",
    "test:rust": "node scripts/toolchain.mjs cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.5",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
